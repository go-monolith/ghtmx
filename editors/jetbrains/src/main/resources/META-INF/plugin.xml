<idea-plugin>
  <id>dev.ghtmx.jetbrains</id>
  <name>ghtmx</name>
  <vendor url="https://github.com/go-monolith/ghtmx">go-monolith</vendor>
  <description><![CDATA[
    Language support for ghtmx templates (.ghtmx): syntax highlighting for
    templates, fragments, events, htmx attributes, and route bindings, plus
    language-server wiring for diagnostics, completion, hover, and go to
    definition via <code>ghtmx lsp</code>.
  ]]></description>

  <depends>com.intellij.modules.platform</depends>
  <!-- The native LSP client API is available in commercial IDEs only. -->
  <depends>com.intellij.modules.ultimate</depends>
  <depends>org.jetbrains.plugins.textmate</depends>

  <!-- No native file type is registered on purpose: the TextMate plugin
       only takes over extensions no registered file type owns, and the
       bundle's manifest claims .ghtmx. The LSP provider matches on the
       file extension, so server wiring is independent of file types. -->
  <extensions defaultExtensionNs="com.intellij">
    <platform.lsp.serverSupportProvider
        implementation="dev.ghtmx.jetbrains.GhtmxLspServerSupportProvider"/>
    <textmate.bundleProvider
        implementation="dev.ghtmx.jetbrains.GhtmxTextMateBundleProvider"/>
  </extensions>
</idea-plugin>
