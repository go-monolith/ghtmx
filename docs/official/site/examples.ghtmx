package site

import "github.com/go-monolith/ghtmx/docs/official/ghtmxgen"

fragment examplesBody(list []Example) {
	<section id="examples">
		<h1>Examples</h1>
		<p>Every example ships in the repository under <code>examples/</code> and runs with <code>ghtmx generate && go run .</code></p>
		<div class="example-grid">
			for _, e := range list {
				<div class="example-card">
					<h2><a href={ ghtmxgen.ExampleDetail(e.Name) } hx-get={ ghtmxgen.ExampleDetail(e.Name) } hx-target="#content" hx-swap="innerHTML" hx-push-url="true">{ e.Title }</a></h2>
					<p>{ e.Description }</p>
				</div>
			}
		</div>
	</section>
}

templ examplesPage(list []Example) {
	@shell("examples") {
		@examplesBody(list)
	}
}

// exampleBody shows an example's README followed by its sources; the
// source text is interpolated, so it arrives escaped, and the
// highlighter picks a grammar per file extension client-side.
fragment exampleBody(e Example, files []SourceFile, readme string) {
	<article id="example" class="doc-article">
		<h1>{ e.Title }</h1>
		<p>{ e.Description }</p>
		if readme != "" {
			@ghtmx.Raw(readme)
		}
		for _, f := range files {
			<h3><code>{ f.Name }</code></h3>
			<pre><code class={ sourceLanguage(f.Name) }>{ f.Source }</code></pre>
		}
		<p><a href={ ghtmx.URL(ghtmxgen.ExamplesIndexPath) } hx-get={ ExamplesIndex } hx-target="#content" hx-swap="innerHTML" hx-push-url="true">All examples</a></p>
	</article>
}

templ examplePage(e Example, files []SourceFile, readme string) {
	@shell("examples") {
		@exampleBody(e, files, readme)
	}
}
