package site

import "github.com/go-monolith/ghtmx/docs/official/ghtmxgen"

// docBody carries one rendered reference document plus breadcrumbs,
// its "On this page" contents, and the reading-order pager. The HTML
// comes from goldmark over repository-owned markdown, so injecting it
// raw is safe by construction.
fragment docBody(p PageView) {
	<div class="doc-row" id="doc">
		<article class="doc-article">
			@breadcrumbs(p)
			@ghtmx.Raw(p.Body)
			@pager(p.Prev, p.Next)
		</article>
		if len(p.TOC) > 0 {
			<aside class="toc">
				<div class="toc-title">On this page</div>
				<ul>
					for _, e := range p.TOC {
						// Anchor IDs are goldmark-generated from repo-owned
						// headings; SafeURL avoids the sanitizer misreading a
						// "#a:b" fragment as a protocol.
						<li class={ tocClass(e.Level) }><a href={ ghtmx.SafeURL("#" + e.ID) }>{ e.Text }</a></li>
					}
				</ul>
			</aside>
		}
	</div>
}

// breadcrumbs is the Docs / category / page trail; section sub-pages
// link back to their category overview.
templ breadcrumbs(p PageView) {
	<div class="breadcrumbs">
		<span>Docs</span>
		if p.Category != "" {
			<span class="crumb-sep">/</span>
			<a href={ ghtmxgen.DocPage("syntax") } hx-get={ ghtmxgen.DocPage("syntax") } hx-target="#content" hx-swap="innerHTML" hx-push-url="true">{ p.Category }</a>
		}
		<span class="crumb-sep">/</span>
		<span class="crumb-here">{ p.Title }</span>
	</div>
}

// pager renders the previous/next reading-order links.
templ pager(prev NavLink, next NavLink) {
	<div class="pager">
		if prev.Href != "" {
			<a class="pager-link" href={ ghtmx.URL(prev.Href) }><span class="pager-dir">Previous</span><span class="pager-title">« { prev.Title }</span></a>
		}
		if next.Href != "" {
			<a class="pager-link pager-next" href={ ghtmx.URL(next.Href) }><span class="pager-dir">Next</span><span class="pager-title">{ next.Title } »</span></a>
		}
	</div>
}

templ docPage(p PageView) {
	@shell(p.Active) {
		@docBody(p)
	}
}

// syntaxIndexBody is the "Syntax and usage" category overview: the
// specification's preamble followed by a card per section sub-page.
fragment syntaxIndexBody(p PageView, sections []DocSection) {
	<div class="doc-row" id="doc">
		<article class="doc-article">
			@breadcrumbs(p)
			@ghtmx.Raw(p.Body)
			<div class="example-grid">
				for _, s := range sections {
					<div class="example-card">
						<h2><a href={ ghtmxgen.SyntaxSection(s.ID) } hx-get={ ghtmxgen.SyntaxSection(s.ID) } hx-target="#content" hx-swap="innerHTML" hx-push-url="true">{ s.Title }</a></h2>
					</div>
				}
			</div>
			@pager(p.Prev, p.Next)
		</article>
	</div>
}

templ syntaxIndexPage(p PageView, sections []DocSection) {
	@shell(p.Active) {
		@syntaxIndexBody(p, sections)
	}
}
