package testspreadattributes

templ BasicTemplate(spread ghtmx.Attributes) {
	<div>
		<a { spread... }>text</a>
		<div
			if true {
				{ spread... }
			}
		>text2</div>
		<div
			if false {
				{ spread... }
			}
		>text3</div>
	</div>
}

templ BasicTemplateOrdered(spread ghtmx.OrderedAttributes) {
	<div>
		<a { spread... }>text</a>
		<div
			if true {
				{ spread... }
			}
		>text2</div>
		<div
			if false {
				{ spread... }
			}
		>text3</div>
	</div>
}
